<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Apple TV app (app.nexstream.one) and its Top Shelf extension (app.nexstream.one.topshelf): both need this App Group
     in their provisioning profiles for the Top Shelf rows; without it the static Top Shelf image is shown. -->
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.nexstream.one</string>
	</array>
</dict>
</plist>
